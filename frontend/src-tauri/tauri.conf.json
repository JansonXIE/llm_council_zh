{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Council",
  "version": "0.1.0",
  "identifier": "com.jianxing.llm-council",
  "build": {
    "beforeDevCommand": {
      "cwd": "..",
      "script": "npm run dev",
      "wait": false
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "npm run build"
    },
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLM Council",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}