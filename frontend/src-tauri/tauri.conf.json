{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM-Council",
  "version": "0.1.0",
  "identifier": "com.jianxing.llm-council",
  "build": {
    "beforeDevCommand": {
      "cwd": "..",
      "script": "npm run dev",
      "wait": false
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "npm run build"
    },
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLM Council",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JansonXIE/llm_council_zh/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/JansonXIE/llm_council_zh/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/JansonXIE/llm_council_zh/releases/latest/download/latest.json"
      ],
      "timeout": 30000,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QzQzREREM0FFMTFDMQpSV1RCRWE3VDNVTjhEYUlEZk1CTkdaa3ZGMVFWbU9iOVVXOHNXTHltUnhqNjhENzBOOGNZZWVKcgo="
    }
  }
}